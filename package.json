{
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1175.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "esbuild": "^0.28.2",
    "hono": "^4.13.20"
  },
  "name": "terraform-import-gate",
  "scripts": {
    "dev": "node --watch src/dev.ts",
    "test": "node --test test/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && zip -q -j dist/app.zip dist/index.js",
    "check": "tsc --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
